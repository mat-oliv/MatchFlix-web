# Copie para .env na raiz: cp .env.example .env
# O Docker Compose lê este arquivo automaticamente.

# --- Postgres ---
POSTGRES_USER=moviematch
POSTGRES_PASSWORD=moviematch
POSTGRES_DB=moviematch
DB_PORT=5432

# --- TMDB ---
# Obrigatório. Gere em https://www.themoviedb.org/settings/api (conta gratuita).
TMDB_API_KEY=

# --- Portas publicadas no host ---
BACKEND_PORT=3333
FRONTEND_PORT=8080        # stack de produção (nginx)
FRONTEND_DEV_PORT=5173    # stack de dev (vite)

# URL do backend do ponto de vista do NAVEGADOR. Só mude se for expor em outro host.
# VITE_API_URL=http://localhost:3333

# Segredo que assina os tokens de sessão (obrigatório). Gere o seu:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
