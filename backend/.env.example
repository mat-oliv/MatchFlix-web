# Copie para backend/.env: cp .env.example .env
# Vale para a execução local (fora do Docker) — na stack do Compose estas variáveis
# são montadas a partir do .env da raiz do projeto.

# Postgres local. Ajuste usuário, senha e porta conforme a sua instalação.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moviematch?schema=public

# Obrigatória. Gere em https://www.themoviedb.org/settings/api (conta gratuita).
TMDB_API_KEY=

# Obrigatória — assina os tokens de sessão; o servidor recusa subir sem ela.
# Gere o seu segredo com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Porta da API. Se mudar, lembre que VITE_API_URL do frontend é lida em build time.
PORT=3333
