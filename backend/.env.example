# Copie para backend/.env: cp .env.example .env
# Vale para a execução local (fora do Docker) — na stack do Compose estas variáveis
# são montadas a partir do .env da raiz do projeto.

# Postgres local. Ajuste usuário, senha e porta conforme a sua instalação.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moviematch?schema=public

# Conexão sem pool, usada pelas migrations. Localmente é igual à DATABASE_URL; na Neon
# é a string SEM o "-pooler" no host, senão `prisma migrate deploy` falha.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/moviematch?schema=public

# Obrigatória. Gere em https://www.themoviedb.org/settings/api (conta gratuita).
TMDB_API_KEY=

# Obrigatória — assina os tokens de sessão; o servidor recusa subir sem ela.
# Gere o seu segredo com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Porta da API. Se mudar, lembre que VITE_API_URL do frontend é lida em build time.
PORT=3333

# Origens liberadas no CORS, separadas por vírgula. Vazio = qualquer origem, que é o
# que o desenvolvimento local quer. Em produção, a URL do site:
#   CORS_ORIGIN=https://seu-site.vercel.app
CORS_ORIGIN=

# Chave do assistente do chat de dúvidas (https://console.anthropic.com). Opcional: sem
# ela a API sobe normalmente e só o chat responde 503, avisando na tela.
#
# NUNCA coloque esta chave numa variável VITE_ do frontend. Tudo que começa com VITE_ é
# gravado no JavaScript público do site — qualquer pessoa lê e gasta o seu crédito. O
# navegador nunca fala com a Anthropic: quem chama é a rota POST /chat, aqui no backend.
ANTHROPIC_API_KEY=
