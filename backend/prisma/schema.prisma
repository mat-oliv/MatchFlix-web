generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Conexão de SESSÃO, usada só pelas migrations. Em produção a DATABASE_URL passa pelo
  // pooler de transação do Supabase (porta 6543), e migration por pooler de transação
  // falha — daí a segunda URL, apontando para a porta 5432 do mesmo host. Em
  // desenvolvimento as duas apontam para o mesmo banco.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  email        String?  @unique
  // Foto de perfil como data URL (o navegador já reduz antes de mandar). Fica no
  // banco pra não precisar de storage de arquivos nem volume só pra isso.
  avatarUrl    String?
  createdAt    DateTime @default(now())

  memberships GroupMember[]
  swipes      Swipe[]
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members GroupMember[]
  matches Match[]
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}

model Swipe {
  id        String   @id @default(cuid())
  userId    String
  movieId   Int
  liked     Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
  // Serve só ao ranking da semana: `liked = true AND createdAt >= X GROUP BY movieId`.
  // A ordem das colunas é o que importa — com `liked` na frente e `createdAt` em
  // seguida, o filtro vira uma faixa contígua do índice em vez de varredura da tabela.
  // `movieId` entra no fim não para filtrar, mas para o Postgres conseguir agrupar sem
  // ir buscar a linha no disco (index-only scan). São 4 bytes por linha a mais num
  // índice que já existiria de qualquer jeito.
  @@index([liked, createdAt, movieId])
}

model Match {
  id        String   @id @default(cuid())
  groupId   String
  movieId   Int
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@unique([groupId, movieId])
  // Serve à consulta do `/me/matches`, que roda de poucos em poucos segundos para cada
  // pessoa com o app aberto: `groupId IN (...) AND createdAt > X`. Com `groupId` na
  // frente, cada grupo vira uma faixa contígua do índice já ordenada por `createdAt`,
  // então o corte por data é o fim da faixa em vez de um filtro linha a linha. O
  // `@@unique` acima não serve aqui: ele é por (groupId, movieId), e não ajuda a cortar
  // por data.
  @@index([groupId, createdAt])
}

// Tempo de uso do site, ANÔNIMO. Não existe relação com `User`, e isso é a regra inteira:
// nenhuma linha diz de quem é o tempo.
//
// Uma linha é um período de uso contínuo de uma aba. O `pseudonimo` é um valor aleatório
// que o NAVEGADOR sorteia para cada conta e guarda só para si — o servidor nunca recebe a
// ligação entre ele e a conta. Ele existe para agrupar as sessões "da mesma pessoa" e
// permitir variância e desvio padrão por pessoa, em vez de uma média de sessões soltas.
//
// Limite conhecido: a mesma pessoa em dois aparelhos vira dois pseudônimos. É o preço de
// o servidor não saber quem é quem.
model SessaoDeUso {
  // Sorteado pela aba (UUID). Nasce no primeiro sinal.
  id          String   @id
  pseudonimo  String
  inicio      DateTime @default(now())
  ultimoSinal DateTime @default(now())
  // Só o tempo entre sinais consecutivos próximos — ver `routes/uso.ts`.
  segundos    Int      @default(0)

  // A estatística agrupa por pessoa: `GROUP BY pseudonimo`.
  @@index([pseudonimo])
}
