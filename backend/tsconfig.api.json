{
  // Só para checagem de tipos: o tsconfig.json principal compila `src` para `dist` e
  // ignora `api/`, que é compilado pela própria Vercel. Este inclui os dois, para que
  // `npm run typecheck` também cubra a função serverless.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "api"]
}
